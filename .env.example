# --- Database ---------------------------------------------------------------
# Local dev (apps run on the host, Postgres in Docker on 55432)
DATABASE_URL=postgres://eia:eia@localhost:55432/eia
# Separate DB for integration tests (created by infra/initdb)
TEST_DATABASE_URL=postgres://eia:eia@localhost:55432/eia_test

# --- SEC EDGAR (required) ---------------------------------------------------
# EDGAR fair-access policy: identify yourself with a name and a contact email.
EDGAR_USER_AGENT="EarningsAgent/1.0 Your Name you@example.com"
EDGAR_MAX_RPS=8

# --- Market data ------------------------------------------------------------
DATA_PROVIDER=finnhub
PROVIDER_API_KEY=
TRANSCRIPTS_ENABLED=false

# --- LLM (needed from Phase 2) ----------------------------------------------
OPENAI_API_KEY=
STRONG_MODEL=
SMALL_MODEL=
EMBED_MODEL=text-embedding-3-small
REVIEW_CONFIDENCE_THRESHOLD=0.85
# Your account's tokens-per-minute limit for STRONG_MODEL (OpenAI > Settings > Limits). 0 = no pacing.
LLM_TPM_LIMIT=0
# Output tokens a call typically uses, reasoning included; reserved against the limit.
LLM_OUTPUT_RESERVE=3000
# Reasoning effort for extraction on reasoning models: minimal | low | medium | high
EXTRACT_REASONING_EFFORT=low
# Prices for cost logging, USD per 1M tokens, e.g. {"my-model":{"inputPerM":1,"cachedInputPerM":0.1,"outputPerM":4}}
LLM_PRICES_JSON=
# Ask refuses below this cosine similarity (text-embedding-3-small)
ASK_SIMILARITY_FLOOR=0.25

# --- Storage & runtime ------------------------------------------------------
RAW_DATA_DIR=./data/raw
CACHE_DIR=./data/cache
PORT=8080
LOG_LEVEL=info
# Comma-separated tickers loaded by `pnpm seed`
WATCHLIST=VST,NVDA,AAPL,MSFT,AMZN,GOOGL,META,JPM,CEG,AVGO
